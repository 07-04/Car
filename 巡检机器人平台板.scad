// ============================================
// 肉牛养殖场巡检机器人 - 平台板图纸
// 文件：巡检机器人平台板.scad
// 用法：OpenSCAD 打开 → F6 渲染 → F7 导出 STL → 切片打印
// ============================================

// ---------- 平台板参数 ----------
plate_w = 120;   // 平台宽(左右) mm
plate_l = 300;   // 平台长(前后，贯穿整车) mm
plate_t = 6;     // 平台厚 mm
hole_d  = 4.5;   // 螺丝孔直径(M4 通过孔) mm
$fn = 48;        // 圆滑度

// ---------- 8 个螺丝孔坐标 ----------
// [左右X, 前后Y] 单位 mm
// 左列 X=5 (离左边缘 5mm)，右列 X=115 (离右边缘 5mm)
// 前单元 Y=25, 110 (孔距 85mm，孔1离前端 25mm)
// 后单元 Y=195, 280 (孔距 85mm，孔1离前端 195mm)
function holes() = [
  [5,  25],  [5,  110],   // 左前单元耳朵
  [115, 25], [115, 110],  // 右前单元耳朵
  [5,  195], [5,  280],   // 左后单元耳朵
  [115, 195], [115, 280]  // 右后单元耳朵
];

// ---------- 平台板 ----------
module plate() {
  difference() {
    cube([plate_w, plate_l, plate_t]);
    for (h = holes())
      translate([h[0], h[1], -1])
        cylinder(d = hole_d, h = plate_t + 2);
  }
}

// 渲染
plate();
